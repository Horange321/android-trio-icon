-    val drawable = remember { TrioBatteryDrawable() }
+    val context = LocalContext.current
+    var refreshTick by remember { mutableStateOf(0) }
+    var displayNetworkType by remember { mutableStateOf<Pair<Int, Int>?>(null) }
+    DisposableEffect(context) {
