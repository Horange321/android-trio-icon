@@ -0,0 +1,33 @@
+# 状态栏电池图标定位与调试过程
+
+记录日期：2026-10-14。
+By GPT-6 Sol.
+下文路径均相对于本 SystemUI 目录。
+
+## 定位结果
+
+- 新版 Compose 实现：`src/com/android/systemui/statusbar/pipeline/battery/ui/composable/UnifiedBattery.kt`。
+- 状态栏挂载点：`src/com/android/systemui/statusbar/pipeline/shared/ui/composable/StatusBarRoot.kt` 中的 `addBatteryComposable`、`addEndSideComposable`，以及同目录的 `DesktopStatusBar.kt`。
+- 其他 View 容器通过 `statusbar/pipeline/battery/ui/binder/UnifiedBatteryViewBinder.kt` 挂载 Compose 电池。
+- Compose 横向外形由 `statusbar/pipeline/battery/shared/ui/BatteryFrame.kt` 定义，直接绘制 Kotlin Path，不读取旧的 unified XML。当前主体内部尺寸为 24 × 13，另有电池端帽路径。
+- View 实现：`src/com/android/systemui/battery/BatteryMeterView.java`。`NewStatusBarIcons.isEnabled()` 为真时使用 `battery/unified/BatteryLayersDrawable.kt`，否则使用旧的竖向 drawable。
+- View 的 unified 资源包括 `res/drawable/battery_unified_frame.xml`、`battery_unified_frame_bg.xml`、`res/values/strings.xml` 中的 `battery_unified_frame_path_string`，布局尺寸使用 `status_bar_battery_unified_icon_width/height`。
+
+## 调试经过与当前修改
+
+最初只在 BatteryMeterView 添加日志。用户反馈 logcat 没有输出，emulator 调电量也没有日志。源码显示 Compose 状态栏会绕过 BatteryMeterView，因此仅在该 View 添加日志不足以覆盖新版路径。尚未通过设备日志确认用户运行镜像的具体路径或部署状态。
+
+当前工作区中的电池日志修改在以下两个文件。
+
+1. `statusbar/pipeline/battery/ui/composable/UnifiedBattery.kt`：使用 `SideEffect` 调用 `Log.d`，tag 为 `UnifiedBattery`。打印 `level`、`iconCharging`、`full`、`glyphs` 和 `frame`。每次成功组合可能打印一次，可能包含初始状态，也可能重复。
+2. `statusbar/policy/BatteryControllerImpl.java`：收到 `ACTION_BATTERY_CHANGED` 后打印，tag 为 `BatteryController`。字段为 `level`、原始 `status`、`charging`、`full`、`pluggedIn`、`pluggedSource`。这里的日志 `charging` 仅在原始 status 为 CHARGING 时为真；控制器内部的 `mCharging` 还将 FULL 视为真。
+
+之前 BatteryMeterView 的日志当前已不在工作区 diff 中，不要假设仍然存在。工作区还存在移动网络相关的其他修改，不属于本次电池任务，不要覆盖或撤销。
+
+## 充电语义与兼容性
+
+- Compose 的 `BatteryViewModel.isCharging` 来自 `BatteryInteractor.isCharging`，当前逻辑为已接电且没有检测到不兼容充电器。这是图标的展示状态，不能直接当作硬件正在给电池充电。
+- `BatteryRepositoryImpl` 使用 `BatteryController` 回调；其电量回调虽然接收 `charging`，当前只保存电量与 `pluggedIn`。
+- `BatteryControllerImpl` 从系统电池广播读取原始 status 和接电来源。emulator 与真机都使用此路径，没有添加基于设备类型的特殊分支。
+- 原始 status：1 未知，2 充电，3 放电，4 未充电，5 已充满。
+- `pluggedSource` 为接电来源位掩码：0 未接电，1 AC，2 USB，4 无线，8 底座。
diff --git a/packages/SystemUI/canvas.py b/packages/SystemUI/canvas.py
new file mode 100644
index 000000000..b2b5142c1
--- /dev/null
+++ b/packages/SystemUI/canvas.py
@@ -0,0 +1,103 @@
+# 用 OpenCV 复刻 Android Canvas 的 "电量 + Wi-Fi + 信号" 图标绘制逻辑。
+# 说明：Android 与 OpenCV 都是 y 轴向下、0° 在 3 点钟方向、正角度顺时针，
+# 因此 drawArc(start, sweep) 可以直接映射为 ellipse 的 startAngle/endAngle。
+import cv2
+import numpy as np
+
+# --- 基础参数（对应原代码） ---
+W = H = 512  # getWidth() / getHeight()
+DENSITY = 16.0  # mTrioDensity，取 2.0 作为典型值
+TEXT_COLOR = (30, 30, 30)  # mTextColor（BGR）
+BACKGROUND = (255, 255, 255)
+
+# (color & 0x00ffffff) | 0x55000000：ARGB 0x55 alpha，这里按背景色模拟合成。
+ALPHA = 0x55 / 255.0
+MUTED = tuple(
+    int(ALPHA * c + (1.0 - ALPHA) * b) for c, b in zip(TEXT_COLOR, BACKGROUND)
+)
+
+canvas = np.full((H, W, 3), BACKGROUND, dtype=np.uint8)
+
+# mTrioPaint.setStrokeWidth(Math.max(1.5f, 2.2f * mTrioDensity))
+STROKE = int(round(2.2 * DENSITY))
+
+w, h = W, H
+cx, cy = w / 2.0, h / 2.0
+radius = min(w, h) * 0.43
+center = (int(round(cx)), int(round(cy)))
+r_int = int(round(radius))
+
+# --- 电量：底环 -200° 起扫 220°（muted），前景按电量百分比绘制（color）。 ---
+# 原代码：double a = 60 * 220f / 100f;  //TODO
+BATTERY_LEVEL = 60  # TODO：替换为真实电量百分比
+START = -200.0
+TOTAL_SWEEP = 220.0
+sweep = TOTAL_SWEEP * BATTERY_LEVEL / 100.0
+
+cv2.ellipse(
+    canvas,
+    center,
+    (r_int, r_int),
+    0,
+    START,
+    START + TOTAL_SWEEP,
+    MUTED,
+    STROKE,
+    cv2.LINE_AA,
+)
+cv2.ellipse(
+    canvas,
+    center,
+    (r_int, r_int),
+    0,
+    START,
+    START + sweep,
+    TEXT_COLOR,
+    STROKE,
+    cv2.LINE_AA,
+)
+
+# --- 中心 Wi-Fi：一个圆点加两段同心弧线，保持等间距与左右对称。 ---
+# 圆点同时作为两段弧线的圆心，整体略向下居中，留出电量环内侧的空白。
+dot_cy = cy + radius * 0.40
+wifi_center = (int(round(cx)), int(round(dot_cy)))
+for i in range(2):
+    arc_radius = int(round(radius * (0.45 + i * 0.45)))
+    # drawArc(bounds, 225f, 90f, ...)
+    c = TEXT_COLOR if i == 0 else MUTED
+    cv2.ellipse(
+        canvas,
+        wifi_center,
+        (arc_radius, arc_radius),
+        0,
+        225.0,
+        315.0,
+        c,
+        int(round(3 * DENSITY)),
+        cv2.LINE_AA,
+    )
+
+# drawCircle(cx, dotCy, dotRadius, ...)，FILL 样式。
+cv2.circle(
+    canvas,
+    wifi_center,
+    int(round(2 * DENSITY)),
+    TEXT_COLOR,
+    -1,
+    cv2.LINE_AA,
+)
+
+# --- 信号：沿圆周分布的四个圆点（原代码循环内统一使用 muted 颜色）。 ---
+signal_dot = int(round(1.8 * DENSITY))
+c = TEXT_COLOR
+for i in range(4):
+    a = -3.0 / 4.0 * np.pi + i * np.pi / 6.0
+    x = cx + radius * np.cos(a)
+    y = cy - radius * np.sin(a)
+    if i == 3:
+        c = MUTED
+    cv2.circle(canvas, (int(round(x)), int(round(y))), signal_dot, c, -1, cv2.LINE_AA)
+
+OUT = "canvas2_out.png"
+cv2.imwrite(OUT, canvas)
+print(f"已保存：{OUT}")
