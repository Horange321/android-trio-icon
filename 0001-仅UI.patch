+package com.android.systemui.battery
+
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.RectF
+import android.graphics.drawable.Drawable
+import kotlin.math.cos
+import kotlin.math.min
+import kotlin.math.sin
+
+/** 状态栏三合一图标，Compose 和 View 共用 canvas.py 的绘制比例。 */
+class TrioBatteryDrawable : Drawable() {
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private var foreground = Color.WHITE
+    private var drawableAlpha = 255
+
+    override fun draw(canvas: Canvas) {
+        val saveCount = canvas.save()
+        try {
+            canvas.translate(bounds.left.toFloat(), bounds.top.toFloat())
+            val side = min(bounds.width(), bounds.height()).toFloat()
+            canvas.translate((bounds.width() - side) / 2f, (bounds.height() - side) / 2f)
+            // 以 canvas.py 的 512 × 512、DENSITY = 16 为基准，所有线宽一起缩放。
+            canvas.scale(side / 512f, side / 512f)
+            val cx = 256f
+            val cy = 256f
+            val radius = 512f * 0.43f
+            val color =
+                (foreground and 0x00ffffff) or
+                    (Color.alpha(foreground) * drawableAlpha / 255 shl 24)
+            val muted = (color and 0x00ffffff) or (Color.alpha(color) * 0x55 / 255 shl 24)
+
+            // TODO：接入真实电量，当前固定为 60%。
+            val batteryLevel = 60
+            val ring = RectF(cx - radius, cy - radius, cx + radius, cy + radius)
+            paint.style = Paint.Style.STROKE
+            paint.strokeCap = Paint.Cap.ROUND
+            paint.strokeWidth = 2.2f * 16f
+            paint.color = muted
+            canvas.drawArc(ring, -200f, 220f, false, paint)
+            paint.color = color
+            canvas.drawArc(ring, -200f, 220f * batteryLevel / 100f, false, paint)
+
+            // TODO：接入 Wi-Fi 连接状态；未连接时在中心显示真实蜂窝类型。
+            // TODO：接入真实 Wi-Fi 强度，当前固定点亮内弧、淡化外弧。
+            val wifiLevel = 1
+            val dotCy = cy + radius * 0.40f
+            paint.strokeWidth = 3f * 16f
+            repeat(2) { index ->
+                val arcRadius = radius * (0.45f + index * 0.45f)
+                paint.color = if (index < wifiLevel) color else muted
+                canvas.drawArc(
+                    RectF(cx - arcRadius, dotCy - arcRadius, cx + arcRadius, dotCy + arcRadius),
+                    225f,
+                    90f,
+                    false,
+                    paint,
+                )
+            }
+            paint.style = Paint.Style.FILL
+            paint.color = color
+            canvas.drawCircle(cx, dotCy, 2f * 16f, paint)
+
+            // TODO：接入真实蜂窝信号强度，当前固定前三点亮起、第四点淡化。
+            val mobileLevel = 3
+            repeat(4) { index ->
+                val angle = -3.0 / 4.0 * Math.PI + index * Math.PI / 6.0
+                paint.color = if (index < mobileLevel) color else muted
+                canvas.drawCircle(
+                    cx + radius * cos(angle).toFloat(),
+                    cy - radius * sin(angle).toFloat(),
+                    1.8f * 16f,
+                    paint,
+                )
+            }
+        } finally {
+            canvas.restoreToCount(saveCount)
+        }
+    }
+
+    override fun setTint(tintColor: Int) {
+        if (foreground != tintColor) {
+            foreground = tintColor
+            invalidateSelf()
+        }
+    }
+
+    override fun setAlpha(alpha: Int) {
+        drawableAlpha = alpha
+        invalidateSelf()
+    }
+
+    override fun setColorFilter(colorFilter: ColorFilter?) {
+        paint.colorFilter = colorFilter
+        invalidateSelf()
+    }
+
+    @Deprecated("Deprecated in Java") override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+}
