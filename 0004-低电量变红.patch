 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/packages/SystemUI/src/com/android/systemui/battery/TrioBatteryDrawable.kt b/packages/SystemUI/src/com/android/systemui/battery/TrioBatteryDrawable.kt
index 548339ec0..e27ce72ac 100644
--- a/packages/SystemUI/src/com/android/systemui/battery/TrioBatteryDrawable.kt
+++ b/packages/SystemUI/src/com/android/systemui/battery/TrioBatteryDrawable.kt
@@ -61,15 +61,17 @@ class TrioBatteryDrawable(private val context: Context) : Drawable() {
             val color = (foreground and 0x00ffffff) or
                     (Color.alpha(foreground) * drawableAlpha / 255 shl 24)
             val muted = (color and 0x00ffffff) or (Color.alpha(color) * 0x55 / 255 shl 24)
-            val ringColor = if (charging)
-                (0x00ff00 or (Color.alpha(color) shl 24))
-            else color
 
             val batteryManager = context.getSystemService(BatteryManager::class.java)
             val batteryLevel =
                 batteryManager?.getIntProperty(BatteryManager.BATTERY_PROPERTY_CAPACITY)
                     ?.takeIf { it in 0..100 } ?: 0
             val ring = RectF(cx - radius, cy - radius, cx + radius, cy + radius)
+            val ringColor = if (charging)
+                (0x00ff00 or (Color.alpha(color) shl 24))
+            else if (batteryLevel <= 20)
+                (0xff0000 or (Color.alpha(color) shl 24))
+            else color
             paint.style = Paint.Style.STROKE
             paint.strokeCap = Paint.Cap.ROUND
             paint.strokeWidth = 2.2f * 16f
